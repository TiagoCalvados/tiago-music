<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tiago Music" Width="800" Height="560" MinWidth="720" MinHeight="500" WindowStartupLocation="CenterScreen" Background="#F4F5FA" FontFamily="Segoe UI" FontSize="13" Foreground="#17223A">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17223A"/><Setter Property="BorderBrush" Value="#DCE0EB"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#6F54CF"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,8,14,8"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
 </Window.Resources>
 <Grid Margin="18,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><TextBlock Text="tiago music" FontSize="23" FontWeight="SemiBold"/><Button x:Name="LyricsButton" Content="Hide lyrics" HorizontalAlignment="Right" Margin="0" Padding="10,6"/></Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition x:Name="LyricsColumn" Width="*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button x:Name="PlaylistsButton" Content="Playlists" Background="#6F54CF" Foreground="White" BorderBrush="#6F54CF"/><Button x:Name="ImportButton" Content="Add folder"/><Button x:Name="HelpButton" Content="USB help" Margin="0"/></StackPanel>
    <Border Grid.Row="1" CornerRadius="14" Padding="16" Background="#202A44">
     <StackPanel><TextBlock Text="NOW PLAYING" Foreground="#BBC1DC" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="SongTitle" Text="Tiago, choose a playlist" FontSize="20" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,7,0,4"/><TextBlock x:Name="SongSubtitle" Text="Open Playlists to get started." Foreground="#CBD1E5" TextTrimming="CharacterEllipsis" FontSize="12"/>
      <Grid Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock x:Name="Elapsed" Text="0:00" Foreground="White" VerticalAlignment="Center"/><Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" Value="0" IsEnabled="False" VerticalAlignment="Center" Margin="6,0" AutomationProperties.Name="Seek position"/><TextBlock x:Name="Duration" Grid.Column="2" Text="0:00" Foreground="White" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="PreviousButton" Content="Previous" IsEnabled="False"/><Button x:Name="PlayButton" Content="Play" Width="92" Background="#AAE4D5" BorderBrush="#AAE4D5" IsEnabled="False"/><Button x:Name="NextButton" Content="Next" IsEnabled="False" Margin="0"/></StackPanel>
     </StackPanel>
    </Border>
    <Grid Grid.Row="2" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><CheckBox x:Name="Shuffle" Content="Shuffle" IsChecked="True" ToolTip="Play every song once in random order before starting a new shuffle."/><CheckBox x:Name="Greeting" Content="Greeting" ToolTip="Optional spoken welcome using a Windows voice. No microphone."/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Vol" Foreground="#68718A" VerticalAlignment="Center" Margin="0,0,5,0"/><Slider x:Name="Volume" Width="75" Minimum="0" Maximum="1" Value="0.7" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Volume"/></StackPanel></Grid>
    <Grid Grid.Row="3" Margin="0,5,0,8"><TextBlock x:Name="PlaylistTitle" Text="Listening queue" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,80,0"/><TextBlock x:Name="TrackCount" Text="0 songs" Foreground="#68718A" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <ListBox x:Name="Tracks" Grid.Row="4" Background="White" BorderBrush="#E0E3ED" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid>
   <Border x:Name="LyricsPanel" Grid.Column="1" Background="White" BorderBrush="#E0E3ED" BorderThickness="1" CornerRadius="14" Margin="16,0,0,0" Padding="14">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,8"><TextBlock Text="Lyrics" FontSize="20" FontWeight="SemiBold"/><CheckBox x:Name="AutomaticLyrics" Content="Auto" HorizontalAlignment="Right" Margin="0" VerticalAlignment="Center" ToolTip="Automatically find lyrics online when a song has no saved lyrics. Sends song name to LRCLIB; audio stays on your PC. Saved lyrics work offline."/></Grid>
     <TextBlock x:Name="LyricNote" Grid.Row="1" Text="Choose a song. Lyrics load automatically; saved lyrics work offline." Foreground="#68718A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <ListBox x:Name="LyricLines" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VirtualizingStackPanel.IsVirtualizing="False">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,11"/><Setter Property="Foreground" Value="#68718A"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontSize" Value="19"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="line" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" Margin="0,2"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#6F54CF"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="FindLyricsButton" Content="Find lyrics" IsEnabled="False"/><Button x:Name="LoadLyricsButton" Content="Load LRC" IsEnabled="False" Margin="0"/></StackPanel>
     <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center"><Button x:Name="EarlierLyricsButton" Content="−0.5s" Padding="7,5" ToolTip="Highlight lyrics half a second earlier."/><TextBlock x:Name="LyricOffset" Text="+0.0s" VerticalAlignment="Center" Width="43" TextAlignment="Center" FontSize="11"/><Button x:Name="LaterLyricsButton" Content="+0.5s" Padding="7,5" ToolTip="Highlight lyrics half a second later."/><Button x:Name="ResetLyricsButton" Content="Reset" Padding="7,5" FontSize="11" Margin="0"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Add a folder to get started. Double-click a song to play." Foreground="#68718A" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/><TextBlock x:Name="PlayState" Grid.Column="1" Text="Ready" FontSize="11" Foreground="#68718A" Margin="12,0,0,0"/></Grid>
 </Grid>
</Window>
